<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Firewall</RootNamespace>
    <AssemblyName>Firewall.Abstractions</AssemblyName>
    <PackageId>Firewall.Abstractions</PackageId>
    <Description>Public contracts for the Firewall middleware: IFirewallRule, FirewallContext, RuleDecision, options records. Reference this package when implementing custom rules or providers.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Primitives" />
  </ItemGroup>

</Project>
