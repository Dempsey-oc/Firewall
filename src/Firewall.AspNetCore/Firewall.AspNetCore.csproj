<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Firewall</RootNamespace>
    <AssemblyName>Firewall.AspNetCore</AssemblyName>
    <PackageId>Firewall.AspNetCore</PackageId>
    <Description>ASP.NET Core middleware and DI surface for the Firewall package. Provides AddFirewall(), UseFirewall() and IFirewallBuilder.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Firewall.Abstractions\Firewall.Abstractions.csproj" />
    <ProjectReference Include="..\Firewall.Core\Firewall.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="Firewall.AspNetCore.Tests" />
    <InternalsVisibleTo Include="Firewall.IntegrationTests" />
  </ItemGroup>

</Project>
