<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Firewall.Caching</RootNamespace>
    <AssemblyName>Firewall.Caching.Hybrid</AssemblyName>
    <PackageId>Firewall.Caching.Hybrid</PackageId>
    <Description>HybridCache (L1+L2) provider for the Firewall package. Caches geo lookups and per-IP decisions across instances when a distributed cache is configured.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Firewall.Abstractions\Firewall.Abstractions.csproj" />
    <ProjectReference Include="..\Firewall.AspNetCore\Firewall.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

</Project>
