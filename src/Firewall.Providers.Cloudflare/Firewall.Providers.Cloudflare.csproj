<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Firewall.Providers.Cloudflare</RootNamespace>
    <AssemblyName>Firewall.Providers.Cloudflare</AssemblyName>
    <PackageId>Firewall.Providers.Cloudflare</PackageId>
    <Description>Cloudflare IP range provider for the Firewall package. Refreshes ranges from https://www.cloudflare.com/ips-v{4,6} on a configurable schedule via IHttpClientFactory + Polly resilience.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Firewall.Abstractions\Firewall.Abstractions.csproj" />
    <ProjectReference Include="..\Firewall.Core\Firewall.Core.csproj" />
    <ProjectReference Include="..\Firewall.AspNetCore\Firewall.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

</Project>
