<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Firewall.HealthChecks</RootNamespace>
    <AssemblyName>Firewall.HealthChecks</AssemblyName>
    <PackageId>Firewall.HealthChecks</PackageId>
    <Description>ASP.NET Core health check integration for the Firewall package. Reports degraded if a provider's snapshot is stale or empty.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Firewall.Abstractions\Firewall.Abstractions.csproj" />
    <ProjectReference Include="..\Firewall.AspNetCore\Firewall.AspNetCore.csproj" />
  </ItemGroup>

</Project>
