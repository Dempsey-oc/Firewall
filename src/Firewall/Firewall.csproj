<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Firewall</RootNamespace>
    <AssemblyName>Firewall</AssemblyName>
    <PackageId>Firewall</PackageId>
    <Description>Meta-package and v3 compatibility shim for the Firewall middleware. Transitively pulls in Firewall.AspNetCore. Existing v3 APIs (FirewallRulesEngine, CIDRNotation, UseFirewall(rule)) are kept as [Obsolete] shims that delegate to the new pipeline.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Firewall.Abstractions\Firewall.Abstractions.csproj" />
    <ProjectReference Include="..\Firewall.Core\Firewall.Core.csproj" />
    <ProjectReference Include="..\Firewall.AspNetCore\Firewall.AspNetCore.csproj" />
  </ItemGroup>

</Project>
