{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Firewall": "Debug"
    }
  },
  "Firewall": {
    "Enabled": true,
    "OnProviderFailure": "UseLastKnownGood",
    "OnDeny": {
      "StatusCode": 403,
      "Body": "",
      "ContentType": "text/plain; charset=utf-8"
    },
    "TrustedProxies": {
      "KnownNetworks": [ "10.0.0.0/8" ],
      "ForwardLimit": 2
    },
    "Rules": {
      "DefaultDeny": false,
      "AllowLocalhost": true,
      "AllowedIps": [
        "10.20.30.40",
        "1.2.3.4"
      ],
      "AllowedCidrs": [
        "110.40.88.0/28"
      ],
      "DeniedCidrs": [],
      "DeniedCountries": []
    }
  },
  "Firewall:Cloudflare": {
    "RefreshInterval": "06:00:00"
  }
}
