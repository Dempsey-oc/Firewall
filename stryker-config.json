{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/docs/stryker-config.schema.json",
  "stryker-config": {
    "project": "src/Firewall.Core/Firewall.Core.csproj",
    "test-projects": [
      "tests/Firewall.Core.Tests/Firewall.Core.Tests.csproj"
    ],
    "language-version": "Latest",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    },
    "reporters": [
      "progress",
      "html",
      "json",
      "cleartext"
    ],
    "mutate": [
      "!**/Internal/**/*.cs",
      "!**/obj/**",
      "!**/bin/**"
    ],
    "concurrency": 4,
    "ignore-mutations": [
      "string"
    ]
  }
}
