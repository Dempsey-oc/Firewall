<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Firewall.Providers.Cloudflare.Tests</RootNamespace>

    <!--
      WireMock.Net 1.9.0 transitively pulls Scriban.Signed. Every published
      Scriban.Signed version has open GHSAs (including the critical
      GHSA-5wr9-m6jw-xx44) with no patched release available. There is no
      version to pin to.

      Scope: this dependency is confined to the TEST binary here. Production
      Firewall.* NuGet packages don't consume WireMock.Net or Scriban and
      are unaffected.

      Mitigation: disable NuGet audit ONLY for this test project so
      TreatWarningsAsErrors doesn't kill the build. Every other project in
      the solution keeps NuGetAudit on and continues to fail restore on any
      real vulnerability.

      Follow-up: replace WireMock.Net with a hand-rolled DelegatingHandler
      mock. Removes the vulnerable transitive entirely at the cost of ~50
      lines of test infra. Tracked as its own PR so this Phase 12 commit
      stays reviewable.
    -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Firewall.Abstractions\Firewall.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Firewall.Core\Firewall.Core.csproj" />
    <ProjectReference Include="..\..\src\Firewall.AspNetCore\Firewall.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Firewall.Providers.Cloudflare\Firewall.Providers.Cloudflare.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
